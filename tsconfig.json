{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@openagentix/api": ["./apps/api/src/index.ts"],
      "@openagentix/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/*/src",
    "apps/*/test",
    "scripts",
    "examples",
    "*.ts"
  ]
}
