{
  "name": "@openagentix/runners",
  "version": "0.0.0",
  "description": "Runner abstraction and agent step executor: in-process and local runners, the oax CLI, stubs for container/Kubernetes/Lambda/CI runners and external harness adapters",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@openagentix/core": "workspace:*",
    "@openagentix/events": "workspace:*",
    "@openagentix/mcp": "workspace:*",
    "@openagentix/providers": "workspace:*",
    "zod": "4.6.5"
  },
  "bin": {
    "oax": "./dist/cli.js"
  }
}
