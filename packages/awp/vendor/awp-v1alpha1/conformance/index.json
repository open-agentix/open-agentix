  "version": "0.1.0",
  "awp": "v1alpha1",
  "defaults": {
    "profiles": [
      "core",
      "governance",
      "audit",
      "security",
      "mcp",
      "a2a"
    ],
    "verifyDigest": false
  },
  "nonManifestExamples": [
    "audit-events.yaml",
    "conformance-statement.yaml",
    "execution-record.yaml"
  ],
