{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentix.si/schema/openagentix-extensions.v1alpha1.json",
  "title": "OpenAgentix extension fields for AWP v1alpha1 manifests",
  "description": "Values of the x-openagentix-* fields, per location. Each $defs entry (Spec, Agent, Step, ToolPermission) describes the object made of the x-openagentix-* members found on one kind of AWP object; it is closed, so an unknown name in the namespace is rejected (fail closed). Locations: Spec = spec of kind Workflow; Agent = an inline agent of spec.agents or the spec of kind Agent; Step = an entry of spec.workflow; ToolPermission = an entry of permissions.tools. Owned by OpenAgentix, not part of AWP, not a conformance claim.",
  "$defs": {
    "RunnerKind": {
      "enum": [
        "in-process",
        "local",
        "container",
        "kubernetes-job",
        "aws-lambda",
        "github-actions",
        "gitlab-ci"
      ]
    },
    "Toolbox": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(\\+[a-z0-9][a-z0-9-]*)*$",
      "maxLength": 128
    },
    "DataClass": {
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "JsonSchemaValue": {
      "type": "object",
      "maxProperties": 64
    },
    "Spec": {
      "type": "object",
      "properties": {
        "x-openagentix-mode": {
          "enum": ["standard", "dark-factory"]
        },
        "x-openagentix-schemas": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,62}$"
          },
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/JsonSchemaValue"
          }
        },
        "x-openagentix-guidelines": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*@\\d+\\.\\d+\\.\\d+$"
          }
        },
        "x-openagentix-runtime": {
          "type": "object",
          "properties": {
            "runner": {
              "$ref": "#/$defs/RunnerKind"
            },
            "toolbox": {
              "$ref": "#/$defs/Toolbox"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "additionalProperties": false
    },
    "Agent": {
      "type": "object",
      "properties": {
        "x-openagentix-description": {
          "type": "string",
          "maxLength": 4096
        },
        "x-openagentix-model": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "maxTokensPerCall": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "x-openagentix-outputs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "format": {
                "enum": [
                  "markdown",
                  "text",
                  "json",
                  "report",
                  "message",
                  "ticket-update",
                  "pull-request"
                ]
              },
              "target": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": ["format"],
            "additionalProperties": false
          }
        },
        "x-openagentix-simulation": {
          "type": "object",
          "properties": {
            "responses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object"
              }
            }
          },
          "required": ["responses"],
          "additionalProperties": false
        },
        "x-openagentix-credentialEnv": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          }
        },
        "x-openagentix-runtime": {
          "type": "object",
          "properties": {
            "runner": {
              "$ref": "#/$defs/RunnerKind"
            },
            "toolbox": {
              "$ref": "#/$defs/Toolbox"
            },
            "harness": {
              "enum": ["claude-code", "opencode"]
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "properties": {
        "x-openagentix-when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "x-openagentix-input": {
          "type": "object",
          "properties": {
            "schema": {
              "$ref": "#/$defs/JsonSchemaValue"
            },
            "from": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              }
            }
          },
          "additionalProperties": false
        },
        "x-openagentix-output": {
          "type": "object",
          "properties": {
            "schema": {
              "$ref": "#/$defs/JsonSchemaValue"
            },
            "onInvalid": {
              "enum": ["fail", "retry"]
            }
          },
          "required": ["schema"],
          "additionalProperties": false
        },
        "x-openagentix-access": {
          "enum": ["read-only", "write"]
        }
      },
      "additionalProperties": false
    },
    "ToolPermission": {
      "type": "object",
      "properties": {
        "x-openagentix-args": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "enum": ["string", "number", "integer", "boolean", "array", "object"]
              },
              "required": {
                "type": "boolean"
              },
              "pattern": {
                "type": "string",
                "maxLength": 1024
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "const": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "minLength": {
                "type": "integer",
                "minimum": 0
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "maxItems": {
                "type": "integer",
                "minimum": 1
              },
              "deny": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "maxLength": 1024
                }
              }
            },
            "additionalProperties": false
          }
        },
        "x-openagentix-allowAdditionalArgs": {
          "type": "boolean"
        },
        "x-openagentix-maxCallsPerRun": {
          "type": "integer",
          "minimum": 1
        },
        "x-openagentix-classification": {
          "$ref": "#/$defs/DataClass"
        }
      },
      "additionalProperties": false
    }
  }
}
