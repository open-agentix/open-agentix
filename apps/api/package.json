{
  "name": "@openagentix/api",
  "version": "0.0.0",
  "private": true,
  "description": "openagentix control node API: agents, events, runs, approvals, audit, costs, RBAC",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "openapi": "node dist/openapi-cli.js ../../openapi.yaml",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/cors": "11.3.0",
    "@fastify/etag": "6.2.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@openagentix/core": "workspace:*",
    "@openagentix/events": "workspace:*",
    "@openagentix/mcp": "workspace:*",
    "@openagentix/providers": "workspace:*",
    "@openagentix/runners": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "iovalkey": "0.4.0",
    "ldapts": "8.2.0",
    "lru-cache": "11.5.3",
    "openapi-types": "12.1.3",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
