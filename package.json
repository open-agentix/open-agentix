{
  "name": "openagentix-platform",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "openagentix: open-source, self-hostable agent platform with policy-checked, audited and cost-tracked agents",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "pnpm --filter @openagentix/ui test:coverage",
    "seed:demo": "pnpm --filter @openagentix/api seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "autocannon": "8.0.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
